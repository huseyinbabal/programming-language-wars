 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "GET p99 latency, now",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "max by (scenario) (k6_http_req_duration_p99{name=\"GET /kv/{key}\"})",
     "legendFormat": "{{scenario}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "fixed"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "go"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#00ADD8"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "rust"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#F74C00"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value_and_name",
    "justifyMode": "center"
   }
  },
