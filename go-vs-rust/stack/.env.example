# Copy to .env (never committed). Defaults fit an 8-core machine.
GF_ADMIN_PASSWORD=change-me

# Public address. A domain name here makes Caddy fetch a certificate (set HTTP_PORT=80, HTTPS_PORT=443).
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost:8097
HTTP_PORT=8097
HTTPS_PORT=8447

# Cores: one set per implementation, one for k6, one for monitoring
CPUS_GO=0,1
CPUS_RUST=2,3
CPUS_LOAD=4,5
CPUS_INFRA=6,7
MEM_LIMIT=1g

CAPACITY=500000
RATE=5000
KEYS=1000000
